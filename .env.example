SHOPIFY_ACCESS_TOKEN=replace_me
SHOPIFY_BLOG_ID=replace_me
SHOPIFY_API_VERSION=2025-01

# Reddit validation
REDDIT_CLIENT_ID=replace_me
REDDIT_CLIENT_SECRET=replace_me
REDDIT_USERNAME=replace_me
REDDIT_PASSWORD=replace_me
REDDIT_USER_AGENT=heyup-buying-guides/0.1

